# --- Model / LLM (reuse existing project config if present) ---
# Format for deepagents/langchain: "provider:model", e.g. openai:gpt-4o-mini, google_genai:gemini-2.0-flash, anthropic:claude-sonnet-4-5
NEWS_MODEL=
# Verified working example (Oct 2026): NEWS_MODEL=groq:openai/gpt-oss-120b (needs langchain-groq)
GROQ_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# --- Search ---
# Optional: Tavily for live news search. Without it the app uses RSS + fixture.
TAVILY_API_KEY=
# --- Output scope (PDF reports + social posts) ---
# job_type: report (research PDF) | social (platform texts). Video is disabled.
JOB_TYPE=report
# Platforms drafted for social jobs (YouTube copy is manual-use only: no text-post API)
SOCIAL_PLATFORMS=x,facebook,hikmah
# Narration/report language, default English; "bn" for Bengali
NARRATION_LANG=en
# Bengali PDF needs a Unicode TTF with Bengali glyphs (e.g. NotoSansBengali-Regular.ttf)
DOC_FONT_TTF=
# --- Speech (LEGACY video scope; not used by report/social jobs) ---
# TTS provider: fixture (offline sine beeps, labeled) | gtts (real voice)
TTS_PROVIDER=fixture
# --- Media (LEGACY video scope; not used by report/social jobs) ---
VIDEO_ASPECT=vertical
DOC_DURATION_SECONDS=75
# Scene visuals: stills (offline generated illustrations) | veo (Google Veo per-scene clips)
VIDEO_PROVIDER=stills
# Verified Gemini API id (Oct 2026, https://ai.google.dev/gemini-api/docs/veo)
VEO_MODEL=veo-3.1-generate-preview
# Set to 1 to attempt real Veo generation (needs GOOGLE_API_KEY + billing)
VEO_ENABLED=0
TIMEZONE=Asia/Dhaka
NEWS_WINDOW_HOURS=24
# --- Publishing ---
# publish_policy: manual (approval pause, default) | auto (publish after quality checks)
# Applies to report readiness + social text posts. No automatic video publishing exists.
PUBLISH_POLICY=manual
# YOUTUBE_* below are LEGACY video scope (preserved). YouTube has no text-post
# API, so social publishing to YouTube is disabled with an explanation.
YOUTUBE_VISIBILITY=unlisted
# YouTube OAuth: path to OAuth client secrets + token file (never commit token)
YOUTUBE_CLIENT_SECRETS=
YOUTUBE_TOKEN_FILE=data/youtube_token.json
YOUTUBE_PUBLISH_MODE=fixture
# --- Shared backend (Express API + worker) ---
API_BASE_URL=http://localhost:4000
API_PORT=4000
# JWT for browser/CLI sessions (generate: openssl rand -hex 32)
JWT_SECRET=
# Service token shared by API + Python worker only (never the browser)
WORKER_SERVICE_TOKEN=
WORKER_ID=worker-1
WORKER_LEASE_SECONDS=300
# --- Persistence ---
# IMPORTANT: API and worker run from different directories — use ABSOLUTE paths
# here, otherwise each service resolves relative paths against its own cwd and
# they silently use different databases/job folders.
JOB_ROOT=/abs/path/to/news-documentary-agent/data/jobs
DB_PATH=/abs/path/to/news-documentary-agent/data/newsdoc.sqlite
# Postgres for shared records (optional; sqlite fallback when unset)
DATABASE_URL=
# Object storage for deployment (optional; local disk when unset)
STORAGE_BACKEND=local
S3_BUCKET=
S3_PREFIX=
S3_REGION=
S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# --- Accounts vault (Express): encrypts connected-account tokens at rest ---
# 64-hex key (generate: openssl rand -hex 32)
ACCOUNTS_ENCRYPTION_KEY=
# --- Limits ---
MAX_COST_USD=5.0
MAX_MODEL_CALLS=40
MAX_RETRIES=2
